APP_NAME="Portfolio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# PERMANENT FREE DATABASE OPTIONS:
# ==========================================
# OPTION 1: SQLite (Easiest local development)
DB_CONNECTION=sqlite

# OPTION 2: Supabase (PostgreSQL - 100% Free Forever, 500MB, No 30-day limit)
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your_project_ref
# DB_PASSWORD=your_supabase_password

# OPTION 3: Neon.tech (Serverless PostgreSQL - Free Forever)
# DB_CONNECTION=pgsql
# DB_HOST=ep-example-12345.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your_neon_password

# OPTION 4: Local MySQL / XAMPP
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=portfolio
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
